#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_fr.h"

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // AZERTY français porté tel quel sur le Corne, coupé en deux moitiés.
            // Les FR_xxx viennent de keys_fr.h : chaque nom = le caractère
            // français qui sera réellement tapé (l'OS doit être en AZERTY).
            // -----------------------------------------------------------------------------------------
            // | ECHAP |  A  |  Z  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BKSP  |
            // | TAB   |  Q  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  M  | ENTREE|
            // | MAJ.G |  W  |  X  |  C  |  V  |  B  |   |  N  |  ,  |  ;  |  :  |  !  | MAJ.D |
            //                      | CTRL| LWR | ESPACE|   | RSE | ALT | WIN  |
            // Avec Maj : , devient ?, ; devient ., : devient /, ! devient §
            // (comme sur un vrai clavier AZERTY), rien à configurer en plus.
            // Maintenir RSE, puis appuyer aussi sur LWR (sans le relâcher) =
            // couche Navigation (voir raise_layer plus bas).

            display-name = "Base";
            bindings = <
&kp ESCAPE  &kp FR_A  &kp FR_Z  &kp E      &kp R     &kp T        &kp Y  &kp U          &kp I           &kp O          &kp P         &kp BACKSPACE
&kp TAB     &kp FR_Q  &kp S     &kp D      &kp F     &kp G        &kp H  &kp J          &kp K           &kp L          &kp FR_M      &kp RET
&kp LSHFT   &kp FR_W  &kp X     &kp C      &kp V     &kp B        &kp N  &kp FR_COMMA   &kp FR_SEMI     &kp FR_COLON   &kp FR_EXCL   &kp RSHFT
                                 &kp LCTRL  &mo 1     &kp SPACE    &mo 2  &kp RALT       &kp LGUI
            >;
        };

        lower_layer {
            // Rangée de chiffres = comportement d'un vrai clavier AZERTY : sans
            // Maj tu obtiens les accents (directement accessibles !), avec Maj
            // (physiquement, en plus de maintenir cette couche) tu obtiens les
            // chiffres 1234567890.
            // -----------------------------------------------------------------------------------------
            // |      |  &  |  é  |  "  |  '  |  (  |   |  -  |  è  |  _  |  ç  |  à  |  )   |
            // |      |     |     |     |     |     |   | GCHE| BAS | HAUT| DRTE|     |      |
            // |      | BTCLR|BT1 | BT2 | BT3 |     |   |     |     |     |     |     |      |
            //                    | CTRL|     | ESPACE|  |     | ALT | WIN  |

            display-name = "Chiffres";
            bindings = <
&trans  &kp FR_AMPR  &kp FR_EACUTE  &kp FR_DQT    &kp FR_QUOT   &kp FR_LPAR    &kp FR_HYPHEN  &kp FR_EGRAVE  &kp FR_UNDER  &kp FR_CCEDIL  &kp FR_AGRAVE  &kp FR_RPAR
&trans  &trans       &trans         &trans        &trans        &trans         &trans         &kp LEFT       &kp DOWN      &kp UP_ARROW   &kp RIGHT      &trans
&trans  &bt BT_CLR   &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &trans         &trans         &trans         &trans        &trans         &trans         &trans
                                    &trans        &trans        &trans         &trans         &trans        &trans
            >;
        };

        raise_layer {
            // Symboles de programmation (AltGr, comme sur un vrai clavier AZERTY
            // français) + touches de fonction F1-F12 + contrôles médias sur les
            // rangées du bas, qui étaient inutilisées.
            // ^ et ` sont des touches mortes : elles se combinent avec la touche
            // suivante (ex: FR_CARET puis E donne "ê"). Pour taper le caractère
            // seul, appuyer sur la touche puis sur Espace.
            //
            // Astuce : en maintenant cette couche (RSE), le pouce gauche qui
            // ouvre normalement Chiffres (LWR) ouvre ici la couche Navigation
            // à la place (&mo 3 remplace &trans à cette position précise).
            // -----------------------------------------------------------------------------------------
            // |      |  ~  |  #  |  {  |  [  |  |  |   |  `  |  \  |  ^  |  @  |  ]  |  }   |
            // |      |  =  | F1  | F2  | F3  | F4  |   | €  | F5  | F6  | F7  | F8  |      |
            // |      |  ù  | F9  | F10 | F11 | F12 |   | $  |  %  |  <  |  >  |     |      |
            //                    | NAV |     | ESPACE|  | RSE | ALT | WIN  |
            // Contrôles média (Vol/lecture/piste) déplacés couche Navigation.

            display-name = "Symboles";
            bindings = <
&trans  &kp FR_TILDE  &kp FR_HASH  &kp FR_LBRACE  &kp FR_LBRKT  &kp FR_PIPE    &kp FR_GRAVE  &kp FR_BSLH  &kp FR_CARET  &kp FR_AT     &kp FR_RBRKT  &kp FR_RBRACE
&trans  &kp FR_EQUAL  &kp F1       &kp F2         &kp F3        &kp F4         &kp FR_EURO   &kp F5       &kp F6        &kp F7        &kp F8        &trans
&trans  &kp FR_UGRAVE &kp F9       &kp F10        &kp F11       &kp F12        &kp FR_DOLLAR &kp FR_PERCENT &kp FR_LT   &kp FR_GT     &trans        &trans
                                   &trans         &mo 3         &trans         &trans        &trans       &trans
            >;
        };

        nav_layer {
            // Pavé numérique (côté gauche) + navigation/édition (côté droit).
            // Accès : maintenir RSE (Symboles), puis appuyer aussi sur LWR
            // (Chiffres) sans relâcher RSE.
            // Les touches KP_xxx sont un vrai pavé numérique matériel : elles
            // tapent toujours un chiffre quel que soit le layout clavier réglé
            // sur l'ordinateur (contrairement à la rangée de chiffres normale
            // qui dépend de l'AZERTY).
            // -----------------------------------------------------------------------------------------
            // |      |  7  |  8  |  9  |  /  |  *  |   |HOME |  UP | END |PGUP |     | BKSP |
            // |      |  4  |  5  |  6  |  -  |  +  |   |GCHE | BAS |DRTE |PGDN | INS | DEL  |
            // |      |  1  |  2  |  3  |  0  |  .  |   |VOL- |VOL+ | ⏯  | ⏮  | ⏭  |      |
            // Le * ci-dessus est le vrai astérisque ASCII (touche pavé
            // numérique), pas le symbole × — important si tu codes.

            display-name = "Navigation";
            bindings = <
&trans  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_SLASH  &kp KP_MULTIPLY    &kp HOME  &kp UP_ARROW  &kp END    &kp PG_UP   &trans  &kp BACKSPACE
&trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS  &kp KP_PLUS        &kp LEFT  &kp DOWN      &kp RIGHT  &kp PG_DN     &kp INSERT  &kp DELETE
&trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N0     &kp KP_DOT         &kp C_VOL_DN &kp C_VOL_UP &kp C_PP  &kp C_PREV    &kp C_NEXT  &trans
                               &trans     &trans        &trans            &trans    &trans        &trans
            >;
        };
    };
};
