#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // AZERTY français porté tel quel sur le Corne : les lettres sont dans le
            // même ordre qu'un clavier AZERTY classique, juste coupé en deux moitiés.
            // ZMK envoie des codes HID "clavier US" ; c'est le layout AZERTY réglé
            // côté OS qui les traduit en lettres françaises. Exemple : le code HID
            // "Q" tape un "A" sous AZERTY, le code HID "A" tape un "Q", etc. C'est la
            // même règle utilisée par tous les claviers ergo francisés (Corne, etc).
            // -----------------------------------------------------------------------------------------
            // | TAB   |  A  |  Z  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BKSP  |
            // | ECHAP |  Q  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  M  | ENTREE|
            // | MAJ.G |  W  |  X  |  C  |  V  |  B  |   |  N  |  ,  |  ;  |  :  |  !  | MAJ.D |
            //                      | WIN | LWR | ESPACE|   | RSE | ALT | CTRL |

            display-name = "Base";
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E  &kp R  &kp T       &kp Y  &kp U  &kp I      &kp O    &kp P      &kp BACKSPACE
&kp ESCAPE  &kp A  &kp S  &kp D  &kp F  &kp G       &kp H  &kp J  &kp K      &kp L    &kp SEMICOLON  &kp RET
&kp LSHFT   &kp Z  &kp X  &kp C  &kp V  &kp B       &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &kp RSHFT
                           &kp LGUI  &mo 1  &kp SPACE       &mo 2  &kp RALT  &kp LCTRL
            >;
        };

        lower_layer {
            // Rangée de chiffres = comportement d'un vrai clavier AZERTY : sans
            // Maj tu obtiens les caractères "&é"'(-è_çà" (accents français
            // directement accessibles !), avec Maj (physiquement, en plus de
            // maintenir cette couche) tu obtiens les chiffres 1234567890.
            // -----------------------------------------------------------------------------------------
            // |      |  &  |  é  |  "  |  '  |  (  |   |  -  |  è  |  _  |  ç  |  à  |  )   |
            // |      |     |     |     |     |     |   | GCHE| BAS | HAUT| DRTE|     |      |
            // |      | BTCLR|BT1 | BT2 | BT3 |     |   |     |     |     |     |     |      |
            //                    | WIN |     | ESPACE|  |     | ALT | CTRL |

            display-name = "Chiffres";
            bindings = <
&trans  &kp N1        &kp N2        &kp N3    &kp N4  &kp N5       &kp N6  &kp N7    &kp N8        &kp N9     &kp N0  &kp MINUS
&trans  &trans        &trans        &trans    &trans  &trans       &trans  &kp LEFT  &kp DOWN      &kp UP_ARROW  &kp RIGHT  &trans
&trans  &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans   &trans  &trans    &trans        &trans     &trans  &trans
                                    &trans    &trans  &trans       &trans  &trans    &trans
            >;
        };

        raise_layer {
            // Symboles de programmation, accessibles via AltGr comme sur un vrai
            // clavier AZERTY français (RA = AltGr). ^ et ` sont des touches
            // mortes : elles se combinent avec la touche suivante (ex: AltGr+9
            // puis E donne "ê"). Pour taper le caractère seul, appuyer sur la
            // touche puis sur Espace.
            // -----------------------------------------------------------------------------------------
            // |      |  ~  |  #  |  {  |  [  |  |  |   |  `  |  \  |  ^  |  @  |  ]  |  }   |
            // |      |  =  |     |     |     |     |   |  €  |     |     |     |     |      |
            // |      |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | WIN |     | ESPACE|  | RSE | ALT | CTRL |

            display-name = "Symboles";
            bindings = <
&trans  &kp RA(N2)  &kp RA(N3)  &kp RA(N4)  &kp RA(N5)  &kp RA(N6)      &kp RA(N7)  &kp RA(N8)  &kp RA(N9)  &kp RA(N0)  &kp RA(MINUS)  &kp RA(EQUAL)
&trans  &kp EQUAL   &trans      &trans      &trans      &trans          &kp RA(E)   &trans      &trans      &trans      &trans         &trans
&trans  &trans      &trans      &trans      &trans      &trans          &trans      &trans      &trans      &trans      &trans         &trans
                                &trans      &trans      &trans          &trans      &trans      &trans
            >;
        };
    };
};
