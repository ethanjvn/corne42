#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keys_fr.h"

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // AZERTY français porté tel quel sur le Corne, coupé en deux moitiés.
            // Les FR_xxx viennent de keys_fr.h : chaque nom = le caractère
            // français qui sera réellement tapé (l'OS doit être en AZERTY).
            // -----------------------------------------------------------------------------------------
            // | ECHAP |  A  |  Z  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BKSP  |
            // | TAB   |  Q  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  M  | ENTREE|
            // | MAJ.G |  W  |  X  |  C  |  V  |  B  |   |  N  |  ,  |  ;  |  :  |  !  | MAJ.D |
            //                      | CTRL| LWR | ESPACE|   | RSE | ALT | WIN  |
            // Avec Maj : , devient ?, ; devient ., : devient /, ! devient §
            // (comme sur un vrai clavier AZERTY), rien à configurer en plus.

            display-name = "Base";
            bindings = <
&kp ESCAPE  &kp FR_A  &kp FR_Z  &kp E      &kp R     &kp T        &kp Y  &kp U          &kp I           &kp O          &kp P         &kp BACKSPACE
&kp TAB     &kp FR_Q  &kp S     &kp D      &kp F     &kp G        &kp H  &kp J          &kp K           &kp L          &kp FR_M      &kp RET
&kp LSHFT   &kp FR_W  &kp X     &kp C      &kp V     &kp B        &kp N  &kp FR_COMMA   &kp FR_SEMI     &kp FR_COLON   &kp FR_EXCL   &kp RSHFT
                                 &kp LCTRL  &mo 1     &kp SPACE    &mo 2  &kp RALT       &kp LGUI
            >;
        };

        lower_layer {
            // Rangée de chiffres = comportement d'un vrai clavier AZERTY : sans
            // Maj tu obtiens les accents (directement accessibles !), avec Maj
            // (physiquement, en plus de maintenir cette couche) tu obtiens les
            // chiffres 1234567890.
            // -----------------------------------------------------------------------------------------
            // |      |  &  |  é  |  "  |  '  |  (  |   |  -  |  è  |  _  |  ç  |  à  |  )   |
            // |      |     |     |     |     |     |   | GCHE| BAS | HAUT| DRTE|     |      |
            // |      | BTCLR|BT1 | BT2 | BT3 |     |   |     |     |     |     |     |      |
            //                    | CTRL|     | ESPACE|  |     | ALT | WIN  |

            display-name = "Chiffres";
            bindings = <
&trans  &kp FR_AMPR  &kp FR_EACUTE  &kp FR_DQT    &kp FR_QUOT   &kp FR_LPAR    &kp FR_HYPHEN  &kp FR_EGRAVE  &kp FR_UNDER  &kp FR_CCEDIL  &kp FR_AGRAVE  &kp FR_RPAR
&trans  &trans       &trans         &trans        &trans        &trans         &trans         &kp LEFT       &kp DOWN      &kp UP_ARROW   &kp RIGHT      &trans
&trans  &bt BT_CLR   &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &trans         &trans         &trans         &trans        &trans         &trans         &trans
                                    &trans        &trans        &trans         &trans         &trans        &trans
            >;
        };

        raise_layer {
            // Symboles de programmation, accessibles via AltGr comme sur un vrai
            // clavier AZERTY français. ^ et ` sont des touches mortes : elles se
            // combinent avec la touche suivante (ex: FR_CARET puis E donne "ê").
            // Pour taper le caractère seul, appuyer sur la touche puis sur Espace.
            // -----------------------------------------------------------------------------------------
            // |      |  ~  |  #  |  {  |  [  |  |  |   |  `  |  \  |  ^  |  @  |  ]  |  }   |
            // |      |  =  |     |     |     |     |   |  €  |     |     |     |     |      |
            // |      |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | CTRL|     | ESPACE|  | RSE | ALT | WIN  |

            display-name = "Symboles";
            bindings = <
&trans  &kp FR_TILDE  &kp FR_HASH  &kp FR_LBRACE  &kp FR_LBRKT  &kp FR_PIPE    &kp FR_GRAVE  &kp FR_BSLH  &kp FR_CARET  &kp FR_AT  &kp FR_RBRKT  &kp FR_RBRACE
&trans  &kp FR_EQUAL  &trans       &trans         &trans        &trans         &kp FR_EURO   &trans       &trans        &trans     &trans        &trans
&trans  &trans        &trans       &trans         &trans        &trans         &trans        &trans       &trans        &trans     &trans        &trans
                                   &trans         &trans        &trans         &trans        &trans       &trans
            >;
        };
    };
};
